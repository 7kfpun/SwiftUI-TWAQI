/* Guide */
"Guide.section_what" = "這是什麼";
"Guide.section_sources" = "從哪裡來";
"Guide.section_health" = "對健康的影響";
"Guide.section_measure" = "如何量測";
"Guide.section_tips" = "你可以怎麼做";
"Guide.section_bands" = "本 App 使用的顏色分級";
"Guide.bands_footer" = "地圖、測站頁面與手錶上的每一筆數值，都依照這些分級上色。";
"Guide.further_reading" = "在維基百科閱讀更多";
"Guide.sources_footer" = "資料來源：環境部；世界衛生組織《全球空氣品質準則》（2021）。";

"Guide.aqi.what" = "用 0 到 500 的單一數字概括空氣品質。六項污染物各自換算到同一個 0–500 的尺度，AQI 取其中最高者，該項污染物即為「指標污染物」。同樣是 160，由臭氧造成與由 PM2.5 造成，需要的防護並不相同，所以值得看看是哪一項污染物在主導。";
"Guide.aqi.measure" = "環境部每小時發布 AQI，但它不是當下那一小時的快照：懸浮微粒採加權移動平均（前 12 小時平均與前 4 小時平均各占一半），臭氧與一氧化碳採 8 小時平均，二氧化硫與二氧化氮則採最新一小時的數值。因此空氣突然變差時，各項污染物的數值會比 AQI 更早反映。";
"Guide.aqi.tips" = "除了數字，也要看趨勢：早上 AQI 若持續上升，往往會一直升到天氣轉變為止。超過 100 時，敏感族群（兒童、長者及心臟或肺部疾病患者）應減少長時間或劇烈的戶外活動；超過 150 時，所有人都應如此。";

"Guide.pm25.what" = "粒徑 2.5 微米以下的微粒，約為頭髮直徑的三十分之一。小到足以深入肺部，最細的還能進入血液。";
"Guide.pm25.sources" = "汽機車廢氣、發電廠、工廠與各種燃燒，加上二氧化硫、氮氧化物與氨在空氣中反應生成的微粒。在台灣，濃度通常從秋季升高到春季：風力減弱讓本地污染累積，東北季風又帶來境外霾害，中南部西半部往往最嚴重。";
"Guide.pm25.health" = "長期暴露與心臟病、中風、肺癌及兒童肺功能發育遲緩有關；短時間的高濃度也可能誘發氣喘與心臟問題。世界衛生組織的準則值為 24 小時平均 15 µg/m³、年平均 5 µg/m³。";
"Guide.pm25.measure" = "單位為微克/立方公尺（µg/m³），每小時量測。AQI 採移動平均，所以每小時的數值會先反映變化。";
"Guide.pm25.tips" = "濃度高時關窗，並開啟具 HEPA 濾網的空氣清淨機。外出時，密合的 N95 或 KN95 口罩能過濾細懸浮微粒；一般醫用口罩不夠密合，效果有限。";

"Guide.pm10.what" = "粒徑 10 微米以下的微粒，包含 PM2.5。其中較粗的部分大多停留在鼻腔、喉嚨與上呼吸道，較少進入肺部深處。";
"Guide.pm10.sources" = "道路與工地揚塵、裸露地表、海鹽，以及春季從中國北方與蒙古吹來的沙塵暴。秋冬起風時，濁水溪裸露的河床會在雲林、彰化一帶揚起大量塵土。";
"Guide.pm10.health" = "刺激眼睛、鼻子與喉嚨，並加重氣喘與支氣管炎。世界衛生組織的準則值為 24 小時平均 45 µg/m³。";
"Guide.pm10.measure" = "單位為微克/立方公尺（µg/m³），每小時量測；AQI 採用與 PM2.5 相同的移動平均。";
"Guide.pm10.tips" = "揚塵日請關窗，清潔時用濕布擦拭，避免乾擦揚起灰塵。口罩對粗顆粒的效果比對 PM2.5 更好。";

"Guide.o3.what" = "指地面的臭氧，而非高空中保護地球的臭氧層。它不是直接排放出來的，而是氮氧化物與揮發性有機物在陽光下反應生成。";
"Guide.o3.sources" = "這些前驅物主要來自交通、工業與溶劑。臭氧需要數小時才會生成，因此常在晴朗炎熱日的中午過後到下午達到高峰，而且下風處的郊區往往比市區更高。";
"Guide.o3.health" = "刺激呼吸道，引起咳嗽、胸悶與呼吸急促，並降低肺功能，運動時尤其明顯。氣喘患者受影響最大。";
"Guide.o3.measure" = "單位為 ppb（十億分之一），每小時量測。AQI 採 8 小時平均，因此會落後於下午的高峰。";
"Guide.o3.tips" = "臭氧偏高的日子，請改在早晨或傍晚運動。臭氧在室內很快就會分解，待在室內相當有效；口罩無法過濾氣體。";

"Guide.co.what" = "燃料在氧氣不足時燃燒所產生的無色無味氣體。";
"Guide.co.sources" = "主要來自汽機車廢氣，因此在交通繁忙的路旁與尖峰時段最高。在台灣的戶外環境中，數值很少超出良好等級。";
"Guide.co.health" = "一氧化碳會取代血液中的氧氣。以戶外的濃度來說，主要影響心臟病患者；高濃度時會造成頭痛、暈眩、意識不清甚至死亡。";
"Guide.co.measure" = "單位為 ppm（百萬分之一），每小時量測，AQI 採 8 小時平均。";
"Guide.co.tips" = "真正的危險在室內。每年冬天，台灣都有裝在密閉陽台或浴室的燃氣熱水器造成一氧化碳中毒：請保持通風，並加裝一氧化碳警報器。";

"Guide.so2.what" = "燃燒含硫燃料時釋放的刺鼻氣體。";
"Guide.so2.sources" = "燃煤與燃油電廠、煉油廠、重工業與船舶。火山噴氣孔也會排放，所以陽明山大屯火山群附近的測站數值可能較高。";
"Guide.so2.health" = "刺激呼吸道，數分鐘內就可能誘發氣喘。在空氣中會轉變為硫酸鹽微粒，增加 PM2.5，也是酸雨的成因之一。";
"Guide.so2.measure" = "單位為 ppb（十億分之一），AQI 採最新一小時的數值。";
"Guide.so2.tips" = "氣喘患者在數值升高時，特別是在工業區或火山噴氣孔附近，請隨身攜帶緩解型吸入劑。";

"Guide.no2.what" = "高溫燃燒時產生的紅棕色氣體。";
"Guide.no2.sources" = "主要來自道路交通，其次是發電廠與工業。在交通繁忙的路旁與尖峰時段最高，離開幾百公尺後就會明顯下降。";
"Guide.no2.health" = "使呼吸道發炎、降低對呼吸道感染的抵抗力；長期暴露與兒童罹患氣喘有關。它也會參與生成臭氧與 PM2.5。";
"Guide.no2.measure" = "單位為 ppb（十億分之一），AQI 採最新一小時的數值。";
"Guide.no2.tips" = "盡量在離大馬路一個街區外的巷道步行、跑步或騎車，並避開尖峰時段。";

