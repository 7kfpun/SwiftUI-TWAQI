// Syncs MOENV air-quality station webcam JPEGs (aqx_p_01) into R2 every 10 minutes,
// and the MOENV air-quality forecast (aqf_p_01) into Directus hourly at :35.
// Deployed by GitHub Actions (.github/workflows/workers.yml) on merge to master.
// Secrets (never in git) are listed in secrets.required; CI uploads them from
// the `workers-production` GitHub environment secrets of the same names on every deploy.
// OPENROUTER_FORECAST_API_KEY pre-translates the forecast text (src/translate.ts).
//
// Public paths:
//   Images (the R2 custom domain of bucket twaqi-station-cams, the "webcam host"; not a Worker route):
//     /stations/{siteId}.jpg, /stations/{siteId}/{yyyy-MM-dd}/{HH}.jpg (hourly, Taiwan time,
//     rolling 24 hours), /manifest.json
//   Worker, on its workers.dev URL (health, webcam status/sync/reads under /station-cams,
//   forecast status/sync under /forecast).
//   Read API (FOX-82, src/api.ts): the `routes` entry below puts /v1/* on the webcam host;
//   every other path there stays R2. It forwards to Cloud Run `twaqi-api`
//   (services/twaqi-api, TWAQI_API_ORIGIN_URL) with TWAQI_API_ORIGIN_TOKEN.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twaqi-workers",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "routes": [{ "pattern": "twaqi.app.wahthefox.com/v1/*", "zone_name": "wahthefox.com" }],
  "r2_buckets": [
    { "binding": "CAMS", "bucket_name": "twaqi-station-cams" }
  ],
  "triggers": {
    "crons": ["*/10 * * * *", "35 * * * *"]
  },
  "vars": {
    "DIRECTUS_URL": "https://cms.wahthefox.com",
    "TWAQI_API_ORIGIN_URL": "https://twaqi-api-994450234819.asia-east1.run.app",
    "TWAQI_API_CACHE_SECONDS": "600"
  },
  "secrets": {
    "required": ["MOENV_API_KEY", "SYNC_TOKEN", "DIRECTUS_FORECAST_TOKEN", "OPENROUTER_FORECAST_API_KEY", "TWAQI_API_ORIGIN_TOKEN"]
  },
  "observability": { "enabled": true }
}
