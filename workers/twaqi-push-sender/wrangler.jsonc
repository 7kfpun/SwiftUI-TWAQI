// AQI threshold alerts for the TWAQI iOS app, sent through Firebase Cloud
// Messaging (HTTP v1). Every 2 hours (:20 past even hours): read every
// station's AQI from the app's API, ask Directus for only the subscriptions
// whose zone that changes, and alert the devices that just crossed in. Only devices with an FCM token are
// sent to; builds still on OneSignal are left to the OneSignal tracker.
// Deployed by GitHub Actions (.github/workflows/workers.yml).
//
// Secrets (never in git) are listed in secrets.required; CI uploads them from
// GitHub environment secrets of the same names on every deploy. See README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twaqi-push-sender",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "triggers": {
    "crons": ["20 */2 * * *"]
  },
  "vars": {
    "DIRECTUS_URL": "https://cms.wahthefox.com",
    "AQI_COUNTRIES": "twn",
    // Minimum gap between two alerts for one subscription, in case the value
    // bounces around the threshold.
    "COOLDOWN_MINUTES": "180",
    // Readings older than this are ignored rather than alerted on.
    "MAX_DATA_AGE_MINUTES": "180",
    // Alerts sent per run; the rest go out on the next run, never twice.
    // Aimed at 40k per 2-hour run. With every send retried, 45k alerts need
    // ~90k FCM requests plus ~2k reads and writes, inside limits.subrequests.
    "MAX_SENDS_PER_RUN": "45000",
    // The run's own count of outgoing requests stops before this; keep it
    // equal to limits.subrequests below.
    "SUBREQUEST_LIMIT": "100000"
  },
  // Workers Paid: 10,000 outgoing requests per run by default, up to 10M.
  // One or two per alert (a 429/5xx is retried once), plus reads and writes.
  // Cron every 2 h gets 15 min CPU and 15 min wall time; 40k sends ~3 min.
  "limits": { "subrequests": 100000 },
  // Every send, for delivery stats (Directus keeps only failures and tests).
  "analytics_engine_datasets": [
    { "binding": "PUSH_EVENTS", "dataset": "twaqi_push_events" }
  ],
  // Per-IP limit on the app's /app/v1 routes (Workers Rate Limiting).
  "ratelimits": [
    { "name": "APP_LIMITER", "namespace_id": "1301", "simple": { "limit": 60, "period": 60 } }
  ],
  "secrets": {
    "required": [
      "FCM_SERVICE_ACCOUNT",
      "DIRECTUS_PUSH_TOKEN",
      "AQI_API_BASE",
      "SYNC_TOKEN"
    ]
  },
  "observability": { "enabled": true }
}
