<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The map's blue dot, "my location" and the nearest-first station list (FOX-54). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".TwaqiApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.TWAQI">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- AdMob app id (FOX-58), from secrets.properties. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${ADMOB_APP_ID}" />
        <!-- Firebase collection at start-up: off in debug builds (FOX-60). TrackingManager sets it
             at every launch, from the build and the per-install opt-out. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="${FIREBASE_COLLECTION_ENABLED}" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${FIREBASE_COLLECTION_ENABLED}" />

        <!-- Below Android 13, AppCompat keeps the app language (AppCompatDelegate.setApplicationLocales)
             and moves it to the system's per-app locale after an upgrade to 13+ (FOX-56). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TWAQI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Feedback form opened outside Help, e.g. from a station's page (FOX-60, FeedbackNavigation). -->
        <activity
            android:name=".feedback.FeedbackActivity"
            android:exported="false"
            android:theme="@style/Theme.TWAQI" />

        <!-- Pro (FOX-58): opened in-app through ProNavigation, and by twaqi://pro?source=… -->
        <activity
            android:name=".pro.ProActivity"
            android:exported="true"
            android:theme="@style/Theme.TWAQI">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="pro"
                    android:scheme="twaqi" />
            </intent-filter>
        </activity>
    </application>

</manifest>
