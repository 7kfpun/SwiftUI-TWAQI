<?xml version="1.0" encoding="utf-8"?>
<!-- FOX-120: the widget picker's preview before Android 15 (previewLayout, API 31+), a capture of
     the generated preview (WidgetPreviews) in drawable-nodpi, in the phone's language. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_preview_air_quality" />
</FrameLayout>
