<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <exclude domain="root" path="cache" />
    <!-- Offline caches (FOX-53): refetched, and purged after a week. -->
    <exclude domain="file" path="offline-cache" />
    <!-- Pro is re-read from Google Play on every start; a copy restored on
         another phone or account must not unlock it there (FOX-58). -->
    <exclude domain="file" path="datastore/pro.preferences_pb" />
    <!-- Push (FOX-57): the device id and secret, and this install's sync state, stay on this
         install. The alerts and quiet hours (push_settings) are backed up and written to the
         new install's own row. -->
    <exclude domain="sharedpref" path="push_identity.xml" />
    <exclude domain="sharedpref" path="push_sync.xml" />
</full-backup-content>
