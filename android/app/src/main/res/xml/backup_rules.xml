<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <exclude domain="root" path="cache" />
    <!-- Offline caches (FOX-53): refetched, and purged after a week. -->
    <exclude domain="file" path="offline-cache" />
    <!-- Pro is re-read from Google Play on every start; a copy restored on
         another phone or account must not unlock it there (FOX-58). -->
    <exclude domain="file" path="datastore/pro.preferences_pb" />
    <!-- Per-install: the analytics opt-out and the feedback's anonymous id (FOX-60). -->
    <exclude domain="sharedpref" path="install.xml" />
    <!-- The last location the app saw, for the widgets' nearest station (FOX-59). -->
    <exclude domain="sharedpref" path="widget_location.xml" />
</full-backup-content>
