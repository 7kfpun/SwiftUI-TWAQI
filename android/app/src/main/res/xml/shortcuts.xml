<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher shortcuts and Google Assistant App Actions (FOX-95, the Android side of iOS
     TWAQIShortcuts). Every intent here is a twaqi:// link the one router (DeepLink) parses.

     The shortcuts themselves are all dynamic (StationShortcuts), so they are named in the app's
     language: "Air quality", the answer card for the nearest station (twaqi://air-quality), then
     one per favourite and recent station (twaqi://station?id=…).

     Assistant: actions.intent.OPEN_APP_FEATURE, with those shortcuts as its inventory. "Open air
     quality in Taiwan Air" matches the "Air quality" shortcut; "Open Songshan in Taiwan Air" a
     station's. Each carries its name in both languages. Any other feature opens the app. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <!-- No shortcut matched the feature: open the app. -->
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.kfpun.twaqi.MainActivity"
            android:targetPackage="com.kfpun.twaqi">
            <parameter
                android:name="feature"
                android:key="feature" />
        </intent>
    </capability>
</shortcuts>
