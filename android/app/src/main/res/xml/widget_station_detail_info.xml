<?xml version="1.0" encoding="utf-8"?>
<!-- FOX-59: one station in detail (iOS extra large), Pro. Placed 4×3, where its sections fit without a gap. Refreshed by WorkManager. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.kfpun.twaqi.widget.WidgetConfigureActivity"
    android:description="@string/widget_detail_description"
    android:initialLayout="@layout/widget_loading"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="180dp"
    android:previewImage="@mipmap/ic_launcher"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
